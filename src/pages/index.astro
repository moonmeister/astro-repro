<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>security.csp and is:inline</title>
	</head>
	<body>
		<h1>security.csp and <code>is:inline</code></h1>
		<ul>
			<li><code>&lt;script is:inline&gt;</code>: <strong id="inline">blocked by CSP</strong> (expected: ran)</li>
			<li><code>&lt;script&gt;</code>, bundled: <strong id="bundled">blocked by CSP</strong> (expected: ran)</li>
		</ul>
		<script is:inline>
			document.getElementById('inline').textContent = 'ran';
		</script>
		<script>
			document.getElementById('bundled')!.textContent = 'ran';
		</script>
	</body>
</html>
